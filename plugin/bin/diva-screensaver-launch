#!/bin/bash

# Opens Diva's screensaver on every monitor, in the default terminal, the
# way Omarchy opens its own (same window class, so Omarchy's idle and lock
# handling recognise it). Adapted from omarchy-launch-screensaver.
#
#   diva-screensaver-launch          start it (does nothing while locked)
#   diva-screensaver-launch force    start it even if she switched it off

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/diva/config.json"

command -v ttfx >/dev/null || exit 1
pgrep -f '[o]rg.omarchy.screensaver' >/dev/null && exit 0
[[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]] && exit 0
if [[ ${1:-} != force ]] && [[ $(jq -r '.screensaver // true' "$CONFIG" 2>/dev/null) == false ]]; then
  exit 1
fi

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)
runner="$here/diva-screensaver"

hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
# Listen before spawning, so a quick terminal cannot open unnoticed.
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET" 2>/dev/null)

wait_for_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$m\" })" >/dev/null 2>&1
  case $terminal in
  *Alacritty*) hypr_exec alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -e "$runner" ;;
  *ghostty*) hypr_exec ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e "$runner" ;;
  *foot*) hypr_exec foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" -e "$runner" ;;
  *kitty*) hypr_exec kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e "$runner" ;;
  *) exit 1 ;;
  esac
  wait_for_window
done

hyprctl dispatch "hl.dsp.focus({ monitor = \"$focused\" })" >/dev/null 2>&1
