#!/usr/bin/env python3
"""List/select installed theme wallpapers without opening another menu."""
import json
import os
from pathlib import Path
import subprocess
import sys

home = Path.home()
current = home / '.local/state/omarchy/current'

def wallpapers():
    theme = (current / 'theme.name').read_text().strip() if (current / 'theme.name').exists() else ''
    roots = [current / 'theme/backgrounds']
    if theme and '/' not in theme and theme not in ('.', '..'):
        roots.append(home / '.config/omarchy/backgrounds' / theme)
    out = {}
    for root in roots:
        if root.is_dir():
            for item in sorted(root.iterdir()):
                if item.is_file() and item.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp'):
                    resolved = str(item.resolve())
                    out[resolved] = {'path': resolved, 'name': item.stem}
    return list(out.values())

if __name__ == '__main__':
    options = wallpapers()
    if sys.argv[1:] == ['list']:
        print(json.dumps(options))
    elif len(sys.argv) == 3 and sys.argv[1] == 'set' and str(Path(sys.argv[2]).resolve()) in {w['path'] for w in options}:
        sys.exit(subprocess.run(['omarchy-theme-bg-set', sys.argv[2]], stdout=subprocess.DEVNULL).returncode)
    else:
        sys.exit(2)
