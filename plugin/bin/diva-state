#!/bin/bash

# What Diva's control centre shows and changes: volume, brightness, Wi-Fi and
# Bluetooth, plus the battery level she mentions. Always prints the current state as one JSON line. Values are
# checked numbers or fixed words; nothing typed reaches a command.
#
#   diva-state                      just the state
#   diva-state volume <0-100>       brightness <1-100>
#   diva-state mute|wifi|bluetooth  toggle

set -uo pipefail

sink=$(omarchy-audio-output-sink 2>/dev/null || true)

percent() { [[ ${1:-} =~ ^[0-9]{1,3}$ ]] && (( $1 <= 100 )); }

case "${1:-}" in
volume)
  # Same sink Omarchy's own volume keys drive.
  percent "${2:-}" && [[ -n $sink ]] && pactl set-sink-volume "$sink" "$2%" 2>/dev/null
  ;;
brightness)
  percent "${2:-}" && omarchy-brightness-display --no-osd "$(( $2 < 1 ? 1 : $2 ))%" >/dev/null 2>&1
  ;;
mute)
  [[ -n $sink ]] && pactl set-sink-mute "$sink" toggle 2>/dev/null
  ;;
wifi)
  if [[ $(nmcli radio wifi 2>/dev/null) == enabled ]]; then nmcli radio wifi off; else nmcli radio wifi on; fi >/dev/null 2>&1
  ;;
bluetooth)
  omarchy-bluetooth-power toggle >/dev/null 2>&1
  ;;
esac

volume=0
muted=false
if [[ -n $sink ]]; then
  volume=$(pactl get-sink-volume "$sink" 2>/dev/null | awk 'NR == 1 { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { sub("%", "", $i); print $i; exit } }')
  [[ $(pactl get-sink-mute "$sink" 2>/dev/null) == *yes ]] && muted=true
fi
brightness=$(brightnessctl -m 2>/dev/null | head -n1 | cut -d, -f4 | tr -d '%')
wifi=false
[[ $(nmcli radio wifi 2>/dev/null) == enabled ]] && wifi=true
network=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2 ~ /wireless/ { print $1; exit }')
nightlight=$(omarchy-toggle-nightlight --status 2>/dev/null | jq -r ' .enabled // false' 2>/dev/null || echo false)
[[ $nightlight == true ]] || nightlight=false
bluetooth=false
omarchy-bluetooth-power is-on >/dev/null 2>&1 && bluetooth=true

battery=""
charging=false
for supply in /sys/class/power_supply/BAT*; do
  [[ -r $supply/capacity ]] || continue
  battery=$(<"$supply/capacity")
  [[ $(<"$supply/status") == Charging || $(<"$supply/status") == Full ]] && charging=true
  break
done

# How long the battery should last at the recent pace, and how hard Diva is
# saving (bin/diva-power): 0 none .. 3 low power mode.
minutes=-1
if [[ $charging == false && -n $battery ]]; then
  left=$(upower -i "$(upower -e 2>/dev/null | grep -m1 -i BAT)" 2>/dev/null | awk '/time to empty:/ { print $4, $5; exit }')
  case "$left" in
  *hours) minutes=$(awk '{ print int($1 * 60) }' <<<"$left") ;;
  *minutes) minutes=$(awk '{ print int($1) }' <<<"$left") ;;
  esac
fi
saving=$(jq -r '.level // 0' "${XDG_STATE_HOME:-$HOME/.local/state}/diva/power.json" 2>/dev/null || echo 0)

jq -nc --arg volume "${volume:-0}" --arg brightness "${brightness:-}" --arg network "${network:-}" \
  --arg battery "${battery:-}" --argjson charging "$charging" --arg minutes "$minutes" --arg saving "${saving:-0}" \
  --argjson muted "$muted" --argjson wifi "$wifi" --argjson bluetooth "$bluetooth" --argjson nightlight "$nightlight" \
  '{volume: ($volume | tonumber? // 0), muted: $muted, brightness: ($brightness | tonumber? // -1),
    wifi: $wifi, network: $network, bluetooth: $bluetooth, nightlight: $nightlight,
    battery: ($battery | tonumber? // -1), charging: $charging,
    minutes: ($minutes | tonumber? // -1), saving: ($saving | tonumber? // 0)}'
