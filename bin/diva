#!/bin/bash

# Diva pack manager: installs, updates and removes the Diva pack for the
# current user. It only touches this user's files; it never uses sudo.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACK="$ROOT/pack.json"

OMARCHY_CONFIG="$HOME/.config/omarchy"
PLUGIN_ID="$(jq -r .id "$ROOT/plugin/manifest.json")"
PLUGIN_SRC="$ROOT/plugin"
PLUGIN_DIR="$OMARCHY_CONFIG/plugins/$PLUGIN_ID"
SHELL_CONFIG="$OMARCHY_CONFIG/shell.json"
BINDINGS="$HOME/.config/hypr/bindings.lua"
# Diva opens on a tap of the Super key alone, when it is released: Hyprland
# then knows no other key was pressed with it, so every Super shortcut keeps
# working. Omarchy's own menu key is taken out so it cannot open in English.
BIND_KEY="SUPER + SUPER_L"
BIND_LABEL="Super (tap)"
MENU_KEY="SUPER + SPACE"
BIND_BEGIN="-- >>> diva: open Diva's menu (written by bin/diva)"
BIND_END="-- <<< diva"
HYPR_MAIN="$HOME/.config/hypr/hyprland.lua"
LOOK_SRC="$ROOT/hypr/diva.lua"
LOOK_FILE="$HOME/.config/hypr/diva.lua"
LOOK_BEGIN="-- >>> diva: rounded, translucent windows and macOS-like input (written by bin/diva)"
LOOK_END="-- <<< diva look"
# Every folder under theme/ is one Diva theme; "diva" is the one applied on
# a first install.
THEME_SLUG="diva"
THEMES_SRC="$ROOT/theme"
THEMES_DIR="$OMARCHY_CONFIG/themes"
THEME_DIR="$THEMES_DIR/$THEME_SLUG"
theme_slugs() { find "$THEMES_SRC" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; }
is_diva_theme() { [[ -n $1 && -d $THEMES_SRC/$1 ]]; }
THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"

# The screensaver: Diva's logo replaces Omarchy's, and Omarchy's own
# screensaver is switched off with its toggle so that Diva's runs instead.
BRANDING_SRC="$ROOT/branding/screensaver.txt"
BRANDING="$OMARCHY_CONFIG/branding/screensaver.txt"
OMARCHY_SAVER_OFF="$HOME/.local/state/omarchy/toggles/screensaver-off"

# Her settings. Created once, never overwritten, left in place by uninstall.
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/diva"
CONFIG="$CONFIG_DIR/config.json"

# Mutable state lives outside the checkout so settings never dirty the repo.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/diva"
STATE="$STATE_DIR/install.json"
BACKUPS="$STATE_DIR/backups"

say() { echo "diva: $*"; }
fail() {
  echo "diva: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage: bin/diva <command>

  install [--no-theme] [--no-look]
                         Install the pack for this user (safe to run again)
  update                 Pull the latest pack from git, then reinstall it
  uninstall              Remove what Diva installed and restore what it replaced
  status                 Show what is installed and whether it is healthy
  ai status|on|off       Show or switch Diva's optional AI assistant
  ai login               Sign in to the Claude subscription in the browser
  ai key                 Store an Anthropic API key instead (for ai.provider = "anthropic")
  ai ask "<request>"     Send one request to the assistant and print its answer
  learned [clear|forget <n>]   List or remove the shortcuts Diva has learned
  test                   Run the pack's checks
USAGE
}

pack() { jq -r "$1" "$PACK"; }
state() { [[ -f $STATE ]] && jq -r "$1 // empty" "$STATE" || true; }
current_theme() { [[ -f $THEME_NAME_FILE ]] && cat "$THEME_NAME_FILE" || true; }
installed() { [[ -f $STATE ]]; }

# Replace a JSON file's contents through a temp file in the same directory,
# so a crash never leaves it half-written.
json_edit() {
  local file="$1" tmp
  shift
  tmp=$(mktemp "$file.diva.XXXXXX")
  if jq "$@" "$file" >"$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    fail "could not edit $file; it was left unchanged"
  fi
}

preflight() {
  local cmd
  for cmd in jq git rsync hyprctl omarchy omarchy-shell omarchy-theme-set; do
    command -v "$cmd" >/dev/null || fail "missing required command: $cmd"
  done
  [[ $EUID -ne 0 ]] || fail "run this as the desktop user, not root"
  omarchy-shell shell ping >/dev/null 2>&1 || fail "the Omarchy shell is not running; log into the desktop first"
  local have tested
  have=$(omarchy version 2>/dev/null || true)
  tested=$(pack .testedOmarchy)
  [[ $have == "$tested"* ]] || say "warning: tested on Omarchy $tested, this is ${have:-unknown}"
}

# Copy the files Diva is about to change into a timestamped folder.
backup() {
  local dir file
  dir="$BACKUPS/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dir"
  for file in "$SHELL_CONFIG" "$BINDINGS" "$HYPR_MAIN" "$CONFIG"; do
    [[ -f $file ]] && cp -p "$file" "$dir/"
  done
  [[ -f $STATE ]] && cp -p "$STATE" "$dir/"
  current_theme >"$dir/theme.name"
  echo "$dir"
}

# Returns 0 when the copy changed something.
sync_dir() {
  local src="$1" dst="$2" changes
  mkdir -p "$dst"
  changes=$(rsync -a --delete --checksum --itemize-changes --exclude tests --exclude __pycache__ --exclude "*.pyc" "$src/" "$dst/")
  [[ -n $changes ]]
}

installed_code_current() {
  [[ -d $PLUGIN_DIR ]] || return 1
  [[ -z $(rsync -an --checksum --itemize-changes --exclude __pycache__ --exclude "*.pyc" "$PLUGIN_SRC/" "$PLUGIN_DIR/") ]]
}

plugin_known() {
  omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null
}

plugin_enabled() {
  omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled == true)' >/dev/null
}

has_binding() { [[ -f $BINDINGS ]] && grep -qF -- "$BIND_BEGIN" "$BINDINGS"; }
binding_current() { has_binding && grep -qF -- "o.bind(\"$BIND_KEY\", \"Diva\"" "$BINDINGS" && grep -qF -- "release = true" "$BINDINGS"; }

# Where a widget sits in the bar, as "section index"; empty when it is absent.
bar_spot() {
  jq -r --arg id "$1" '.bar.layout // {} | to_entries[] | .key as $s | .value | to_entries[]
    | select(.value.id == $id) | "\($s) \(.key)"' "$SHELL_CONFIG" | head -n1
}

# Diva's button takes the place of the Omarchy menu button. Only the button
# goes: the Omarchy menu itself stays enabled, because Omarchy's own pickers
# and the power, theme and capture menus are drawn by it.
take_menu_button() {
  local spot tmp
  spot=$(bar_spot omarchy.menu)
  [[ -n $spot ]] || return 0
  tmp=$(mktemp "$SHELL_CONFIG.diva.XXXXXX")
  if jq '.bar.layout |= with_entries(.value |= map(select(.id != "omarchy.menu")))' "$SHELL_CONFIG" >"$tmp"; then
    mv "$tmp" "$SHELL_CONFIG"
  else
    rm -f "$tmp"
    say "warning: could not remove the Omarchy menu button from the bar"
    return 0
  fi
  omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
  omarchy bar move "$PLUGIN_ID" --section "${spot% *}" --index "${spot#* }" >/dev/null ||
    say "warning: could not move the Diva button"
  MENU_BUTTON="$spot"
}

restore_menu_button() {
  local spot="$1"
  [[ -n $spot && -z $(bar_spot omarchy.menu) ]] || return 0
  omarchy bar put omarchy.menu --section "${spot% *}" --index "${spot#* }" >/dev/null ||
    say "warning: could not put the Omarchy menu button back; run: omarchy bar put omarchy.menu --section left --index 0"
}

# Save complete workspace entries once, so uninstall restores their settings.
# The dock is part of Diva's widget; workspaces now live in the overview.
take_workspace_widgets() {
  WORKSPACE_WIDGETS=$(jq -c '[.bar.layout // {} | to_entries[] | .key as $section | .value | to_entries[] | select(.value.id == "omarchy.workspaces") | {section: $section, index: .key, entry: .value}]' "$SHELL_CONFIG")
  json_edit "$SHELL_CONFIG" '.bar.layout |= with_entries(.value |= map(select(.id != "omarchy.workspaces")))'
}

restore_workspace_widgets() {
  local records="$1"
  [[ -n $records ]] || return 0
  json_edit "$SHELL_CONFIG" --argjson records "$records" '
    reduce $records[] as $r (. ;
      if any(.bar.layout[$r.section][]; .id == "omarchy.workspaces") then .
      else .bar.layout[$r.section] = (.bar.layout[$r.section] // [] | .[:$r.index] + [$r.entry] + .[$r.index:]) end)'
}

hypr_ok() { [[ -z $(hyprctl configerrors 2>/dev/null | tr -d '[:space:]') ]]; }

# A marked block is the only thing Diva writes into her Hyprland files.
# block_remove takes the file and the block's first and last lines.
block_remove() {
  local file="$1" begin="$2" end="$3" tmp kept
  [[ -f $file ]] && grep -qF -- "$begin" "$file" || return 0
  # Command substitution also drops the blank line the block was written after.
  kept=$(awk -v b="$begin" -v e="$end" '$0 == b {skip = 1} !skip {print} $0 == e {skip = 0}' "$file")
  tmp=$(mktemp "$file.diva.XXXXXX")
  printf '%s\n' "$kept" >"$tmp"
  mv "$tmp" "$file"
}

block_add() {
  local file="$1" begin="$2" end="$3" body="$4"
  [[ -f $file ]] || return 1
  block_remove "$file" "$begin" "$end"
  printf '\n%s\n%s\n%s\n' "$begin" "$body" "$end" >>"$file"
}

remove_binding() {
  block_remove "$BINDINGS" "$BIND_BEGIN" "$BIND_END"
  hyprctl reload >/dev/null 2>&1 || true
}

# Taken out again if Hyprland reports a config error with it in.
add_binding() {
  binding_current && return 0
  block_add "$BINDINGS" "$BIND_BEGIN" "$BIND_END" \
    "hl.unbind(\"$MENU_KEY\")
o.bind(\"$BIND_KEY\", \"Diva\", \"omarchy-shell shell toggle $PLUGIN_ID '{}'\", { release = true })" || return 0
  hyprctl reload >/dev/null 2>&1 || true
  sleep 0.3
  if ! hypr_ok; then
    remove_binding
    say "warning: the $BIND_LABEL shortcut was not added because Hyprland rejected it"
  fi
}

# Done once: keep the logo that was there, put Diva's, and silence Omarchy's
# screensaver unless it was already off.
take_screensaver() {
  mkdir -p "$(dirname "$BRANDING")" "$(dirname "$OMARCHY_SAVER_OFF")"
  [[ -f $BRANDING && ! -f $STATE_DIR/screensaver.txt.before ]] && cp -p "$BRANDING" "$STATE_DIR/screensaver.txt.before"
  cp "$BRANDING_SRC" "$BRANDING"
  if [[ -f $OMARCHY_SAVER_OFF ]]; then
    SCREENSAVER=kept-off
  else
    : >"$OMARCHY_SAVER_OFF"
    SCREENSAVER=taken
  fi
}

give_back_screensaver() {
  [[ -n $1 ]] || return 0
  if [[ -f $STATE_DIR/screensaver.txt.before ]]; then
    # Only if the logo is still Diva's: one she drew herself stays.
    cmp -s "$BRANDING" "$BRANDING_SRC" && cp -p "$STATE_DIR/screensaver.txt.before" "$BRANDING"
    rm -f "$STATE_DIR/screensaver.txt.before"
  fi
  [[ $1 == taken ]] && rm -f "$OMARCHY_SAVER_OFF"
  return 0
}

has_look() { [[ -f $HYPR_MAIN ]] && grep -qF -- "$LOOK_BEGIN" "$HYPR_MAIN"; }

remove_look() {
  block_remove "$HYPR_MAIN" "$LOOK_BEGIN" "$LOOK_END"
  rm -f "$LOOK_FILE"
  hyprctl reload >/dev/null 2>&1 || true
}

# Diva's Hyprland look is one file of hers plus one require() line. Both go
# again if Hyprland reports a config error with them in.
add_look() {
  cp "$LOOK_SRC" "$LOOK_FILE"
  has_look || block_add "$HYPR_MAIN" "$LOOK_BEGIN" "$LOOK_END" 'require("hypr.diva")' || return 0
  hyprctl reload >/dev/null 2>&1 || true
  sleep 0.4
  if ! hypr_ok; then
    say "warning: Diva's window look was not applied because Hyprland rejected it:"
    hyprctl configerrors 2>/dev/null | head -n 5 >&2
    remove_look
    return 1
  fi
}

cmd_install() {
  local apply_theme=true apply_look=true arg
  for arg in "$@"; do
    case "$arg" in
    --no-theme) apply_theme=false ;;
    --no-look) apply_look=false ;;
    *) fail "unknown install option: $arg" ;;
    esac
  done

  preflight
  omarchy plugin validate "$PLUGIN_SRC" >/dev/null || fail "the Diva plugin does not validate; nothing was changed"
  # Validate QML before copying a potentially unfinished concurrent edit.
  "$ROOT/tests/preview.sh" >/dev/null || fail "Diva's QML preview failed; nothing was changed"
  mkdir -p "$STATE_DIR" "$CONFIG_DIR"

  local first=true backup_dir previous_theme plugin_changed=false theme_changed=false path
  installed && first=false
  backup_dir=$(backup)
  previous_theme=$(state .previousTheme)
  MENU_BUTTON=$(state .menuButton)
  WORKSPACE_WIDGETS=$(state .workspaceWidgets)
  [[ $(state .desktopNavigation) == true ]] || take_workspace_widgets

  local look
  look=$(state .look)
  SCREENSAVER=$(state .screensaver)

  # Anything already sitting where Diva installs, and not put there by Diva,
  # is kept in the backup rather than overwritten.
  if $first; then
    for path in "$PLUGIN_DIR" $(theme_slugs | sed "s|^|$THEMES_DIR/|"); do
      if [[ -e $path ]]; then
        cp -a "$path" "$backup_dir/$(basename "$(dirname "$path")")-$(basename "$path")"
        say "kept a copy of the existing $path in $backup_dir"
      fi
    done
  fi

  [[ -f $CONFIG ]] || echo '{ "name": "", "animations": true, "ai": { "enabled": false, "provider": "claude" } }' >"$CONFIG"

  if sync_dir "$PLUGIN_SRC" "$PLUGIN_DIR"; then plugin_changed=true; fi
  # All her themes are installed; only a change to the one in use matters now.
  local slug
  for slug in $(theme_slugs); do
    if sync_dir "$THEMES_SRC/$slug" "$THEMES_DIR/$slug" && [[ $(current_theme) == "$slug" ]]; then theme_changed=true; fi
  done

  omarchy-shell shell rescanPlugins >/dev/null
  for _ in $(seq 1 40); do
    plugin_known && break
    sleep 0.05
  done
  plugin_known || fail "the Omarchy shell did not discover the Diva plugin"

  # Enabled once, with a button on the left of the bar and a shortcut. After
  # that the choices are hers, and an update must not undo them.
  if $first; then
    omarchy plugin enable "$PLUGIN_ID" --section left >/dev/null || fail "could not enable the Diva plugin"
    add_binding
    previous_theme=$(current_theme)
    if $apply_theme; then
      omarchy-theme-set "$THEME_SLUG" >/dev/null || say "warning: could not apply the Diva theme"
    fi
  elif $theme_changed; then
    omarchy-theme-set "$(current_theme)" >/dev/null || say "warning: could not re-apply the theme in use"
  fi

  # Done once, and again only for an install made before Diva replaced the
  # Omarchy menu. If she later puts the Omarchy button back, it stays.
  if [[ -z $MENU_BUTTON ]]; then
    take_menu_button
    add_binding
  elif has_binding && ! binding_current; then
    # An install from before the shortcut changed: rewrite Diva's own block.
    add_binding
  fi

  # Applied once ("on"), or declined once ("off"); an update only refreshes
  # the file of an install that has it, so removing the require() line sticks.
  if [[ -z $look ]]; then
    look=off
    if $apply_look && add_look; then look=on; fi
  elif [[ $look == on ]] && has_look && ! cmp -s "$LOOK_SRC" "$LOOK_FILE"; then
    add_look || look=off
  fi

  if [[ -z $SCREENSAVER ]]; then
    take_screensaver
  elif cmp -s "$BRANDING" "$STATE_DIR/screensaver.logo.installed" 2>/dev/null && ! cmp -s "$BRANDING" "$BRANDING_SRC"; then
    # Still the logo Diva installed last time, and the pack's has changed.
    cp "$BRANDING_SRC" "$BRANDING"
  fi
  cp "$BRANDING_SRC" "$STATE_DIR/screensaver.logo.installed"

  jq -n --arg version "$(pack .version)" --arg commit "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)" \
    --arg when "$(date -Is)" --arg theme "$previous_theme" --arg button "$MENU_BUTTON" --arg look "$look" --arg saver "$SCREENSAVER" --argjson workspaces "${WORKSPACE_WIDGETS:-[]}" \
    '{version: $version, commit: $commit, installedAt: $when, previousTheme: $theme, menuButton: $button, look: $look, screensaver: $saver, desktopNavigation: true, workspaceWidgets: $workspaces}' >"$STATE"

  # The plugin is keepLoaded and Quickshell caches loaded QML, so changed code
  # needs a fresh shell. A first install has nothing cached.
  if ! $first && $plugin_changed; then
    say "restarting the Omarchy shell to load the new Diva code"
    omarchy-restart-shell >/dev/null 2>&1 || say "warning: restart the shell yourself with: omarchy restart shell"
  fi

  say "Diva $(pack .version) is installed. Backup: $backup_dir"
  say "Open it with the Diva button in the bar, or a tap of the Super key"
}

cmd_update() {
  installed || fail "Diva is not installed; run: bin/diva install"
  [[ -d $ROOT/.git ]] || fail "$ROOT is not a git checkout, so there is nothing to pull from"
  [[ -z $(git -C "$ROOT" status --porcelain) ]] ||
    fail "the pack checkout has local changes; commit or discard them first"
  local before
  before=$(git -C "$ROOT" rev-parse HEAD)
  git -C "$ROOT" pull --ff-only --quiet || fail "could not pull; nothing was changed"
  if [[ $(git -C "$ROOT" rev-parse HEAD) == "$before" ]]; then
    say "already up to date"
  fi
  # Run the freshly pulled script, not the copy bash is still reading.
  exec "$ROOT/bin/diva" install
}

cmd_uninstall() {
  installed || fail "Diva is not installed"
  preflight
  local backup_dir previous_theme menu_button
  backup_dir=$(backup)
  previous_theme=$(state .previousTheme)
  menu_button=$(state .menuButton)

  if is_diva_theme "$(current_theme)" && [[ -n $previous_theme ]] && ! is_diva_theme "$previous_theme"; then
    omarchy-theme-set "$previous_theme" >/dev/null || say "warning: could not restore theme '$previous_theme'"
  fi
  # Give back anything Diva was holding down to save the battery.
  [[ -x $PLUGIN_DIR/bin/diva-power ]] && "$PLUGIN_DIR/bin/diva-power" restore >/dev/null 2>&1
  give_back_screensaver "$(state .screensaver)"
  rm -f "$STATE_DIR/screensaver.logo.installed"
  remove_binding
  remove_look
  omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  restore_menu_button "$menu_button"
  restore_workspace_widgets "$(state .workspaceWidgets)"
  local slug
  for slug in $(theme_slugs); do rm -rf "${THEMES_DIR:?}/$slug"; done
  rm -rf "$PLUGIN_DIR"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

  rm -f "$STATE"
  omarchy-restart-shell >/dev/null 2>&1 || true
  say "Diva is removed. Her settings stay in $CONFIG; a backup is in $backup_dir"
}

cmd_status() {
  local ok=true
  check() {
    if "${@:2}" >/dev/null 2>&1; then
      echo "  ok       $1"
    else
      echo "  MISSING  $1"
      ok=false
    fi
  }
  if installed; then
    echo "Diva $(state .version) (commit $(state .commit | cut -c1-7)), installed $(state .installedAt)"
  else
    echo "Diva is not installed"
  fi
  check "Diva plugin files" test -f "$PLUGIN_DIR/manifest.json"
  check "Diva plugin enabled" plugin_enabled
  check "Diva desktop service responds" omarchy-shell diva.desktop status
  check "Installed Diva code matches this checkout" installed_code_current
  check "Diva shortcut ($BIND_LABEL)" binding_current
  check "Diva window look" has_look
  check "Hyprland config has no errors" hypr_ok
  check "Omarchy menu still available" omarchy-shell shell call omarchy.menu ping "{}"
  check "Diva themes ($(theme_slugs | wc -l))" bash -c 'for s in "$@"; do test -f "$0/$s/colors.toml" || exit 1; done' "$THEMES_DIR" $(theme_slugs)
  check "Diva settings file" jq -e . "$CONFIG"
  check "Diva screensaver logo" cmp -s "$BRANDING" "$BRANDING_SRC"
  echo "  theme    $(current_theme)"
  echo "  backups  $(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l) in $BACKUPS"
  $ok
}

LEARNED="$STATE_DIR/learned.json"
KEY_FILE="$CONFIG_DIR/api-key"

cmd_ai() {
  [[ -f $CONFIG ]] || fail "no settings file yet; run: bin/diva install"
  case "${1:-status}" in
  status)
    echo "assistant  $(jq -r 'if .ai.enabled == true then "on" else "off" end' "$CONFIG")"
    "$PLUGIN_SRC/bin/diva-ai" --status |
      jq -r '"provider   \(.provider)\nsigned in  \(.loggedIn)" + (if .plan != "" then "\nplan       \(.plan)" else "" end) + (if .cli then "" else "\nClaude Code is not installed" end)'
    ;;
  login) exec "$PLUGIN_SRC/bin/diva-ai" --login ;;
  on | off)
    local enabled=false
    [[ $1 == on ]] && enabled=true
    json_edit "$CONFIG" --argjson enabled "$enabled" '.ai = ((.ai // {}) + {enabled: $enabled})'
    say "assistant is $1"
    [[ $1 == off ]] || "$PLUGIN_SRC/bin/diva-ai" --status | jq -e '.loggedIn' >/dev/null || say "not signed in yet; run: bin/diva ai login"
    ;;
  key)
    local key
    if [[ -t 0 ]]; then
      read -rsp "Anthropic API key: " key
      echo
    else
      read -r key
    fi
    [[ -n $key ]] || fail "no key given"
    (umask 077 && printf '%s\n' "$key" >"$KEY_FILE")
    chmod 600 "$KEY_FILE"
    say "key stored in $KEY_FILE (readable only by you)"
    ;;
  ask)
    [[ -n ${2:-} ]] || fail "usage: bin/diva ai ask \"<request>\""
    "$PLUGIN_SRC/bin/diva-ai" "$(jq -nc --arg request "$2" '{request: $request, actions: [], apps: []}')"
    ;;
  *) fail "unknown ai command: $1" ;;
  esac
}

cmd_learned() {
  [[ -s $LEARNED ]] || { echo "Diva has not learned any shortcut yet."; return 0; }
  case "${1:-list}" in
  list) jq -r 'to_entries[] | "\(.key + 1). \(.value.request)  ->  \(.value.title)"' "$LEARNED" ;;
  clear)
    echo '[]' >"$LEARNED"
    say "learned shortcuts cleared"
    ;;
  forget)
    [[ ${2:-} =~ ^[0-9]+$ ]] || fail "usage: bin/diva learned forget <number>"
    json_edit "$LEARNED" --argjson n "$2" 'del(.[$n - 1])'
    say "forgot shortcut $2"
    ;;
  *) fail "unknown learned command: $1" ;;
  esac
}

cmd_test() {
  local runner=/usr/lib/qt6/bin/qmltestrunner
  [[ -x $runner ]] || fail "qmltestrunner not found at $runner"
  jq -e . "$PACK" >/dev/null
  omarchy plugin validate "$PLUGIN_SRC"
  bash -n "$PLUGIN_SRC/bin/diva-ai"
  bash -n "$PLUGIN_SRC/bin/diva-plugins"
  bash -n "$PLUGIN_SRC/bin/diva-install"
  bash -n "$PLUGIN_SRC/bin/diva-state"
  bash -n "$PLUGIN_SRC/bin/diva-window"
  bash -n "$PLUGIN_SRC/bin/diva-run"
  bash -n "$PLUGIN_SRC/bin/diva-power"
  bash -n "$PLUGIN_SRC/bin/diva-screensaver"
  bash -n "$PLUGIN_SRC/bin/diva-screensaver-launch"
  bash -n "$PLUGIN_SRC/bin/diva-doctor"
  "$ROOT/tests/test_hypr.sh"
  python3 "$ROOT/tests/test_wallpapers.py"
  python3 "$ROOT/tests/test_install.py"
  "$ROOT/tests/preview.sh"
  env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen QT_QUICK_CONTROLS_STYLE=Basic "$runner" -silent -input "$ROOT/tests"
}

command="${1:-help}"
shift || true
case "$command" in
install) cmd_install "$@" ;;
update) cmd_update ;;
uninstall) cmd_uninstall ;;
status) cmd_status ;;
ai) cmd_ai "$@" ;;
learned) cmd_learned "$@" ;;
test) cmd_test ;;
-h | --help | help) usage ;;
*)
  usage >&2
  exit 1
  ;;
esac
